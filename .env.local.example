# Required for POST /api/query and POST /api/watch/* authentication
EIE_TOOL_API_KEY=your-secret-api-key-here

# Phase 12 Vercel Cron manual smoke testing (server-side only)
# Generate locally: openssl rand -hex 32
CRON_SECRET=replace_me_with_a_long_random_secret

# Optional Phase 11 durable watchlist persistence (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Phase 20 internal review queue access (server-side only)
# Generate locally: openssl rand -hex 32
INTERNAL_REVIEW_ACCESS_TOKEN=replace_me_with_a_long_random_secret

# Phase 23A operator magic-link redirect base (required in production)
# Set to your deployed app origin so login emails do not redirect to localhost.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# Phase 32/38 external Mind send config (server-side only; disabled by default)
# test_sink remains the default handoff destination in the UI.
# Dry-run: ENABLE_EXTERNAL_MIND_SEND=true + HTTPS endpoint + API key allows gated animoca_mind
#   creation and dry-run send (external_dry_run_ok audit; no external POST).
# Live external HTTP delivery requires BOTH ENABLE_EXTERNAL_MIND_SEND=true and EXTERNAL_MIND_LIVE_SEND=true.
# Live delivery is not production-validated as of Phase 38E; disable LIVE_SEND after any staging test.
ENABLE_EXTERNAL_MIND_SEND=false
EXTERNAL_MIND_LIVE_SEND=false
EXTERNAL_MIND_ENDPOINT_URL=
EXTERNAL_MIND_API_KEY=
EXTERNAL_MIND_SEND_TIMEOUT_MS=15000
# Comma-separated hostnames; leave empty to allow any parsed endpoint host
EXTERNAL_MIND_ENDPOINT_ALLOWLIST=
